# ============================================
# Planting Atlas — Environment Variables
# ============================================

# Google AdSense
# ------------------------------------------------
# Set to "true" ONLY after Google has approved the site for AdSense.
# Leaving this off prevents the ads script from loading, which helps with approval.
#
# After approval:
#   1. Set NEXT_PUBLIC_ENABLE_ADSENSE=true
#   2. Run: npm run build
#   3. Deploy the new build
#
# See src/app/layout.jsx for implementation details.
NEXT_PUBLIC_ENABLE_ADSENSE=false

# Google Ads Conversion Tracking
# ------------------------------------------------
# Leave unset until a real Google Ads account exists. Set to your account's
# Conversion ID (e.g. "AW-XXXXXXXXX", found in Google Ads under Tools &
# Settings > Conversions) once campaigns are ready to track. Individual
# conversion events fire via reportConversion() in src/logic/analytics.js —
# each call site (wizard completion, newsletter signup, etc.) also needs the
# matching per-action conversion label from that same Google Ads screen.
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
